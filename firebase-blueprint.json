{
  "entities": {
    "users": {
      "title": "UserProfile",
      "description": "Personal account and workspace data for each user/doctor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" }
      },
      "required": ["id", "email", "displayName"]
    },
    "newsCards": {
      "title": "NewsCard",
      "description": "Personal cloud news card document for a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "sourceId": { "type": "string" },
        "sourceName": { "type": "string" },
        "publishedAt": { "type": "string" },
        "fetchedAt": { "type": "string" },
        "isRead": { "type": "boolean" },
        "isStarred": { "type": "boolean" },
        "isHidden": { "type": "boolean" },
        "savedLater": { "type": "boolean" },
        "userNote": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "url", "sourceId", "sourceName", "publishedAt", "fetchedAt", "updatedAt"]
    },
    "userSecrets": {
      "title": "UserSecrets",
      "description": "Server-side only AI keys and sensitive credentials",
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "apiKey": { "type": "string" },
        "model": { "type": "string" },
        "url": { "type": "string" },
        "customPrompt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "users" },
      "description": "User profile collection"
    },
    "/users/{userId}/newsCards/{cardId}": {
      "schema": { "$ref": "newsCards" },
      "description": "User personal cloud news cards collection"
    },
    "/userSecrets/{userId}": {
      "schema": { "$ref": "userSecrets" },
      "description": "User sensitive server-only credentials"
    }
  }
}
