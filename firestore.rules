rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify if the authenticated user is an admin via trusted server-assigned custom claims
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User profile, notes, timers, schedules, feeds, and personal workspace data
    // Fully persistent across all deployments and server restarts
    match /users/{userId} {
      // Strictly isolated to document owner or admin
      allow read: if isOwner(userId) || isAdmin();

      // Creation: Regular users can only create their own profile with role: 'user' and no elevated privilege fields
      allow create: if request.auth != null && (
        isAdmin() || (
          isOwner(userId) &&
          (!('role' in request.resource.data) || request.resource.data.role == 'user') &&
          (!('admin' in request.resource.data) || request.resource.data.admin != true) &&
          !('permissions' in request.resource.data) &&
          !('isSuperAdmin' in request.resource.data)
        )
      );

      // Updates: Regular users can update their personal settings, but CANNOT modify privilege fields (role, admin, permissions, isSuperAdmin)
      allow update: if request.auth != null && (
        isAdmin() || (
          isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'admin', 'permissions', 'isSuperAdmin'])
        )
      );

      // Deletion: Document owner or admin
      allow delete: if isOwner(userId) || isAdmin();
      
      // Personal news cards collection strictly isolated to document owner or admin
      match /newsCards/{cardId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Subcollections or nested user data strictly isolated to document owner or admin
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // User secrets (AI keys, provider tokens) - SERVER ONLY, strictly forbidden for client read/write
    match /userSecrets/{userId} {
      allow read, write: if false;
    }

    // System configurations, curated feed registries, and app state
    match /system/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Backup snapshots
    match /backups/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}

